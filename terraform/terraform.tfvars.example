aws_region    = "eu-west-3"
instance_type = "t3.micro"
docker_image  = "jeremygovi/planning-poker:latest"

# Restrict this to your office/VPN egress addresses whenever possible.
allowed_cidrs = ["203.0.113.10/32"]

